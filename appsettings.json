{
  "Jwt": {
    "Issuer": "URLShortner.API",
    "Audience": "URLShortner.Client",
    "ExpirationMinutes": 60
  },
  "ShortCode": {
    "ReservedShortCode": [
      "api",
      "swagger",
      "login",
      "register",
      "admin",
      "dashboard",
      "health"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}